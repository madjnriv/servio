{
  "expo": {
    "scheme": "servio",
    "name": "servio",
    "slug": "servio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "dark",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "bundleIdentifier": "com.servio.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.servio.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./src/assets/android-icon-foreground.png",
        "backgroundImage": "./src/assets/android-icon-background.png",
        "monochromeImage": "./src/assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./src/assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "53daacd4-ae95-4c21-9aa1-c395af954842"
      }
    },
    "owner": "ivs-team",
    "plugins": ["expo-router"]
  }
}
